; Engine configuration file.
; Grand Bruxelles Game — prototype

config_version=5

[application]

config/name="Grand Bruxelles Game"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DirectSpawnPresentation="*res://game/scripts/direct_spawn_presentation.gd"
GrandPlaceOfficialLod2="*res://game/scripts/grand_place_official_lod2_1655673.gd"
GrandPlaceOfficialLod2Next="*res://game/scripts/grand_place_official_lod2_1786758.gd"
GrandPlaceGranitePaving="*res://game/scripts/grand_place_granite_paving.gd"
VisibleCityRuntime="*res://game/scripts/visible_city_runtime.gd"
BourseMetroIdentityRuntime="*res://game/scripts/bourse_metro_identity_runtime.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

3d/default_gravity=9.8
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

debug/shapes/collision/shape_color=Color(0.1, 0.8, 0.3, 0.25)