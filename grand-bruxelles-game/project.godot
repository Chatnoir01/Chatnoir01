; Engine configuration file.
; Grand Bruxelles Game — prototype

config_version=5

[application]

config/name="Grand Bruxelles Game"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DirectSpawnPresentation="*res://game/scripts/direct_spawn_presentation.gd"
GrandPlaceOfficialLod2="*res://game/scripts/grand_place_official_lod2_1655673.gd"
GrandPlaceOfficialLod2Next="*res://game/scripts/grand_place_official_lod2_1786758.gd"
GrandPlaceGranitePaving="*res://game/scripts/grand_place_granite_paving.gd"
GrandPlaceWhiteStoneSurfaceRuntime="*res://game/scripts/grand_place_white_stone_surface_runtime.gd"
GrandPlaceSlateRoofSurfaceRuntime="*res://game/scripts/grand_place_slate_roof_surface_runtime.gd"
VisibleCityRuntime="*res://game/scripts/visible_city_runtime.gd"
LivingCityShowcaseRuntime="*res://game/scripts/living_city_showcase_runtime.gd"
MidiAmbientNpcVisualRuntime="*res://game/scripts/midi_ambient_npc_visual_runtime.gd"
MidiProfiledNpcGaitRuntime="*res://game/scripts/midi_profiled_npc_gait_runtime.gd"
MidiBlueStoneSurfaceRuntime="*res://game/scripts/midi_blue_stone_surface_runtime.gd"
MidiArchitecturalConcreteSurfaceRuntime="*res://game/scripts/midi_architectural_concrete_surface_runtime.gd"
MidiArchitecturalGlazingSurfaceRuntime="*res://game/scripts/midi_architectural_glazing_surface_runtime.gd"
MidiFauquenbergBrickSurfaceRuntime="*res://game/scripts/midi_fauquenberg_brick_surface_runtime.gd"
BourseWhiteStoneSurfaceRuntime="*res://game/scripts/bourse_white_stone_surface_runtime.gd"
BourseLimestoneBaseSurfaceRuntime="*res://game/scripts/bourse_limestone_base_surface_runtime.gd"
BourseArchitecturalGlazingSurfaceRuntime="*res://game/scripts/bourse_architectural_glazing_surface_runtime.gd"
AuthoredPlayerLocomotionRuntime="*res://game/scripts/authored_player_locomotion_runtime.gd"
BrusselsUnclassifiedMassingSurfaceRuntime="*res://game/scripts/brussels_unclassified_massing_surface_runtime.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

3d/default_gravity=9.8
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

debug/shapes/collision/shape_color=Color(0.1, 0.8, 0.3, 0.25)