{
  "schema": "grand-bruxelles-city-machine-registry-v1",
  "version": 4,
  "catalog": "data/qa/playable_zone_catalog.json",
  "pilot_zone": "jette",
  "zone_profiles": {
    "jette": {
      "source_root": "data/urbis/laeken_jette/jette_phase2",
      "validator_script": "tools/validate_jette_phase2_data.py",
      "runtime_script": "game/zones/laeken_jette/jette_phase2_zone.gd",
      "materialized_slugs": ["buildings", "street_surfaces", "street_axes", "train_network"],
      "ground_contract": {"mode": "manifest_bbox_reference_plane", "ground_y": 0.0},
      "content_minimums": {"buildings": 1, "street_surfaces": 1},
      "osm_environment": {
        "cache": "data/osm/zones/jette/environment.raw.json",
        "runtime": "data/osm/zones/jette/environment.game.json",
        "minimum_trees": 1,
        "bounds_tolerance_m": 2.0
      }
    }
  },
  "layers": [
    {"order": 10, "layer_id": "resolve_catalog_zone", "kind": "resolve_zone", "script": "tools/city_machine/city_machine.py", "inputs": ["data/qa/playable_zone_catalog.json"], "outputs": [], "gate": null, "enabled_zones": ["*"]},
    {"order": 20, "layer_id": "materialize_buildings_runtime", "kind": "materialize_geojson", "slug": "buildings", "script": "tools/lambert72_to_game_geojson.py", "inputs": ["profile:source_root/buildings.geojson"], "outputs": ["profile:source_root/buildings.game.json"], "gate": null, "enabled_zones": ["*"]},
    {"order": 30, "layer_id": "materialize_street_surfaces_runtime", "kind": "materialize_geojson", "slug": "street_surfaces", "script": "tools/lambert72_to_game_geojson.py", "inputs": ["profile:source_root/street_surfaces.geojson"], "outputs": ["profile:source_root/street_surfaces.game.json"], "gate": null, "enabled_zones": ["*"]},
    {"order": 40, "layer_id": "materialize_street_axes_runtime", "kind": "materialize_geojson", "slug": "street_axes", "script": "tools/lambert72_to_game_geojson.py", "inputs": ["profile:source_root/street_axes.geojson"], "outputs": ["profile:source_root/street_axes.game.json"], "gate": null, "enabled_zones": ["*"]},
    {"order": 50, "layer_id": "materialize_train_network_runtime", "kind": "materialize_geojson", "slug": "train_network", "script": "tools/lambert72_to_game_geojson.py", "inputs": ["profile:source_root/train_network.geojson"], "outputs": ["profile:source_root/train_network.game.json"], "gate": null, "enabled_zones": ["*"]},
    {"order": 55, "layer_id": "osm_environment_points", "kind": "materialize_osm_environment", "script": "tools/city_machine/build_osm_environment_zone.py", "inputs": ["profile:osm_environment.cache", "profile:source_root/manifest.json"], "outputs": ["profile:osm_environment.runtime"], "gate": null, "enabled_zones": ["*"]},
    {"order": 60, "layer_id": "validate_urbis_source_contract", "kind": "validate_existing", "script": "tools/city_machine/city_machine.py", "inputs": ["profile:source_root/manifest.json", "profile:validator_script"], "outputs": [], "gate": "G1_sources_crs", "enabled_zones": ["*"]},
    {"order": 70, "layer_id": "gate_spawn_ground", "kind": "gate_spawn_ground", "script": "tools/city_machine/city_machine.py", "inputs": ["data/qa/playable_zone_catalog.json", "profile:source_root/manifest.json"], "outputs": [], "gate": "G2_spawn_ground", "enabled_zones": ["*"]},
    {"order": 80, "layer_id": "gate_runtime_content", "kind": "gate_runtime_content", "script": "tools/city_machine/city_machine.py", "inputs": ["profile:source_root/buildings.game.json", "profile:source_root/street_surfaces.game.json"], "outputs": [], "gate": "G3_buildings_streets", "enabled_zones": ["*"]},
    {"order": 90, "layer_id": "runtime_finish_contract", "kind": "gate_finish_contract", "script": "tools/city_machine/city_machine.py", "inputs": ["profile:runtime_script", "profile:source_root/*.game.json"], "outputs": ["Godot load-time materials/ground/official geometry"], "gate": "G4_runtime_finish", "enabled_zones": ["*"]},
    {"order": 100, "layer_id": "gate_osm_environment", "kind": "gate_osm_environment", "script": "tools/city_machine/city_machine.py", "inputs": ["profile:osm_environment.cache", "profile:osm_environment.runtime"], "outputs": [], "gate": "G5_osm_environment", "enabled_zones": ["*"]},
    {"order": 105, "layer_id": "runtime_environment_index", "kind": "materialize_runtime_environment_index", "script": "tools/city_machine/build_runtime_environment_index.py", "inputs": ["tools/city_machine/registry.json", "profile:osm_environment.runtime"], "outputs": ["data/runtime/runtime_environment_index.json"], "gate": null, "enabled_zones": ["*"]},
    {"order": 110, "layer_id": "facade_candidate_pipeline", "kind": "disabled", "script": "tools/city_generation/generate_facade_candidates.py", "inputs": ["remaining_brussels 500m cells", "visual consensus"], "outputs": ["candidate recipes/QA only"], "gate": null, "enabled_zones": [], "disabled_reason": "candidate-only pipeline explicitly performs no runtime mutation and is not wired to an approved City Machine runtime application contract"},
    {"order": 120, "layer_id": "live_urbis_refresh", "kind": "disabled", "script": "tools/fetch_urbis_jette_phase2.py", "inputs": ["official UrbIS WFS"], "outputs": ["raw+game zone datasets"], "gate": null, "enabled_zones": [], "disabled_reason": "network refresh is non-nominal; machine v4 rebuild consumes committed/cached authoritative raw sources"},
    {"order": 130, "layer_id": "live_osm_environment_refresh", "kind": "disabled", "script": "tools/city_machine/build_osm_environment_zone.py", "inputs": ["OSM Overpass", "profile:source_root/manifest.json"], "outputs": ["profile:osm_environment.cache"], "gate": null, "enabled_zones": [], "disabled_reason": "live Overpass refresh is evidence/bootstrap only; nominal builds consume committed normalized ODbL caches"}
  ],
  "tool_inventory": {
    "citygen": ["assess_cell_elevation_values.py", "autonomous_citygen.py", "bootstrap_cell_maturity.py", "build_brussels_regional_grid.py", "build_cell_candidate_package.py", "build_cell_elevation_candidate_frontier.py", "build_cell_elevation_requirements.py", "build_manual_frontier_review.py", "build_semantic_dsm_height_comparison.py", "collect_manual_frontier_reviews.py", "derive_cell_building_height_candidates.py", "evaluate_cell_dtm_lod.py", "materialize_urbis_source_cell.py", "persist_secondary_height_evidence.py", "resolve_cell_elevation_sources.py", "select_stale_quarantine_repairs.py", "validate_cell_elevation_archives.py", "validate_cell_elevation_rasters.py", "validate_secondary_height_evidence.py"],
    "city_generation": ["apply_facade_rules.py", "build_candidate_qa_queue.py", "build_mass_candidate_manifest.py", "generate_facade_candidates.py", "regenerate_facade_recipes.py"],
    "jette_support": ["tools/fetch_urbis_jette_phase2.py", "tools/validate_jette_phase2_data.py", "tools/lambert72_to_game_geojson.py"],
    "osm_environment": ["tools/fetch_osm_slice.py", "tools/transform_osm_to_game.py", "tools/make_runtime_slice.py", "tools/measure_osm_environment_coverage.py", "tools/city_machine/build_osm_environment_zone.py", "tools/city_machine/build_runtime_environment_index.py"]
  }
}
